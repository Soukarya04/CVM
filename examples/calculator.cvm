// Simple Calculator

fn add(a, b)      { return a + b; }
fn subtract(a, b) { return a - b; }
fn multiply(a, b) { return a * b; }
fn divide(a, b)   { return a / b; }
fn modulo(a, b)   { return a % b; }

print "Please enter the first number:";
let a = input;
print "Please enter the second number:";
let b = input;
print "Please choose the desired operation:";
print "1 = Addition, 2 = Subtraction, 3 = Multiplication, 4 = Division, 5 = Modulo";
let op = input;   

if (op == 1) {
    print add(a, b);
} else if (op == 2) {
    print subtract(a, b);
} else if (op == 3) {
    print multiply(a, b);
} else if (op == 4) {
    print divide(a, b);
} else if (op == 5) {
    print modulo(a, b);
} else {
    print "Invalid operator";
}