// Prime Number Checker — prints all primes from 2 to 50

fn isPrime(n) {
    if (n < 2) { return false; }
    let i = 2;
    while (i * i <= n) {
        if (n % i == 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

for (let i = 2; i <= 50; i = i + 1) {
    if (isPrime(i)) {
        print i;
    }
}