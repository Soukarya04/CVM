// FizzBuzz 1–20 using booleans
// CVM++ doesn't have modulo, so we use subtraction loops to
// check divisibility. This shows off if/else and while loops.
// so we have used the trick (i/n)*n == i to check divisibility of i by n

let i = 1;
while (i < 21) {
    // Check divisible by 15 (both 3 and 5)
    let d15 = i / 15;
    let d3  = i / 3;
    let d5  = i / 5;

    if ((d15 * 15) == i) {
        print 0;    // 0 = FizzBuzz marker
    } else {
        if ((d3 * 3) == i) {
            print 1;   // 1 = Fizz marker
        } else {
            if ((d5 * 5) == i) {
                print 2;   // 2 = Buzz marker
            } else {
                print i;
            }
        }
    }
    i = i + 1;
}
